#!/usr/bin/env bash
# Setups the repository.

# Stop on errors
set -e

cd "$(dirname "$0")/.."

python3 - <<'PY'
import json
from pathlib import Path

config_path = Path(".mcp.json")
config = json.loads(config_path.read_text()) if config_path.exists() else {}
servers = config.setdefault("mcpServers", {})
servers["playwright"] = {
    "type": "local",
    "command": "/usr/local/bin/playwright-mcp",
    "args": [
        "--storage-state",
        "/workspaces/ha_segment_state_prediction/playwright/.ha_storage_state.json",
        "--block-service-workers",
    ],
    "tools": ["*"],
    "env": {"PLAYWRIGHT_BROWSERS_PATH": "/opt/ms-playwright"},
}
config_path.write_text(json.dumps(config, indent=2) + "\n")
PY

# Add default vscode settings if not existing
SETTINGS_FILE=./.vscode/settings.json
SETTINGS_TEMPLATE_FILE=./.vscode/settings.default.jsonc
if [ ! -f "$SETTINGS_FILE" ]; then
    echo "Copy $SETTINGS_TEMPLATE_FILE to $SETTINGS_FILE."
    cp "$SETTINGS_TEMPLATE_FILE" "$SETTINGS_FILE"
fi

mkdir -p config

if [ ! -n "$VIRTUAL_ENV" ]; then
  if [ -x "$(command -v uv)" ]; then
    uv venv .venv
  else
    python3 -m venv .venv
  fi
  source .venv/bin/activate
fi

if ! [ -x "$(command -v uv)" ]; then
  python3 -m pip install uv
fi

script/bootstrap

prek install

hass --script ensure_config -c config

if ! grep -R "logger" config/configuration.yaml >> /dev/null; then
echo "
logger:
  default: info
  logs:
    homeassistant.components.cloud: debug
" >> config/configuration.yaml
fi

if ! grep -R "debug_console" config/configuration.yaml >> /dev/null; then
echo "
debug_console:
" >> config/configuration.yaml
fi
